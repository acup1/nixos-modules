{
  "schemaVersion": 1,
  "title": "Веб-браузеры",
  "description": "Google Chrome, Tor Browser и Zen Browser.",
  "layers": {
    "nixos": [
      "linux"
    ],
    "darwin": [
      "darwin"
    ],
    "home": [
      "linux",
      "darwin"
    ]
  },
  "options": [
    {
      "layer": "nixos",
      "path": [
        "components",
        "browsers",
        "packages"
      ],
      "title": "Пакеты",
      "description": "Имена пакетов из nixpkgs, которыми можно заменить стандартный список компонента.",
      "type": "packages"
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "browsers",
        "enabledPackages",
        "google-chrome"
      ],
      "title": "Google Chrome",
      "description": "Подключает Google Chrome в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "browsers",
        "enabledPackages",
        "tor-browser"
      ],
      "title": "Tor Browser",
      "description": "Подключает Tor Browser в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "browsers",
        "enabledPackages",
        "zen-browser"
      ],
      "title": "Zen Browser",
      "description": "Подключает Zen Browser в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "darwin",
      "path": [
        "components",
        "browsers",
        "packages"
      ],
      "title": "Пакеты",
      "description": "Имена пакетов из nixpkgs, которыми можно заменить стандартный список компонента.",
      "type": "packages"
    },
    {
      "layer": "darwin",
      "path": [
        "components",
        "browsers",
        "enabledPackages",
        "zen-browser"
      ],
      "title": "Zen Browser",
      "description": "Устанавливает пакет и применяет связанные с ним настройки компонента.",
      "type": "bool",
      "default": true,
      "systems": [
        "aarch64-darwin"
      ]
    },
    {
      "layer": "darwin",
      "path": [
        "components",
        "browsers",
        "enabledPackages",
        "google-chrome"
      ],
      "title": "Google Chrome",
      "description": "Устанавливает браузер через Homebrew.",
      "type": "bool",
      "default": false
    },
    {
      "layer": "darwin",
      "path": [
        "components",
        "browsers",
        "enabledPackages",
        "tor-browser"
      ],
      "title": "Tor Browser",
      "description": "Устанавливает браузер через Homebrew.",
      "type": "bool",
      "default": false
    },
    {
      "layer": "home",
      "path": [
        "components",
        "browsers",
        "mcp",
        "chrome",
        "enable"
      ],
      "title": "Chrome MCP",
      "description": "Включить MCP и команду запуска отдельного профиля.",
      "type": "bool",
      "default": false
    },
    {
      "layer": "home",
      "path": [
        "components",
        "browsers",
        "mcp",
        "chrome",
        "port"
      ],
      "title": "Порт Chrome MCP",
      "description": "Порт отладки на loopback.",
      "type": "integer",
      "default": 9222
    },
    {
      "layer": "home",
      "path": [
        "components",
        "browsers",
        "mcp",
        "chrome",
        "profileDirectory"
      ],
      "title": "Профиль Chrome MCP",
      "description": "Абсолютный путь к отдельному профилю браузера для MCP.",
      "type": "string"
    },
    {
      "layer": "home",
      "path": [
        "components",
        "browsers",
        "mcp",
        "chrome",
        "executable"
      ],
      "title": "Исполняемый файл Chrome",
      "description": "Путь к браузеру или команда из PATH.",
      "type": "string"
    },
    {
      "layer": "home",
      "path": [
        "components",
        "browsers",
        "mcp",
        "zen",
        "enable"
      ],
      "title": "Zen MCP",
      "description": "Включить MCP и команду запуска отдельного профиля.",
      "type": "bool",
      "default": false
    },
    {
      "layer": "home",
      "path": [
        "components",
        "browsers",
        "mcp",
        "zen",
        "port"
      ],
      "title": "Порт Zen MCP",
      "description": "Порт отладки на loopback.",
      "type": "integer",
      "default": 9223
    },
    {
      "layer": "home",
      "path": [
        "components",
        "browsers",
        "mcp",
        "zen",
        "profileDirectory"
      ],
      "title": "Профиль Zen MCP",
      "description": "Абсолютный путь к отдельному профилю браузера для MCP.",
      "type": "string"
    },
    {
      "layer": "home",
      "path": [
        "components",
        "browsers",
        "mcp",
        "zen",
        "executable"
      ],
      "title": "Исполняемый файл Zen",
      "description": "Путь к браузеру или команда из PATH.",
      "type": "string"
    }
  ]
}
