{
  "schemaVersion": 1,
  "title": "Базовая система NixOS",
  "description": "Настраивает Nix, кеши, сеть, SSH и Zsh, добавляет базовые утилиты.",
  "layers": {
    "nixos": [
      "linux"
    ]
  },
  "options": [
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "packages"
      ],
      "title": "Пакеты",
      "description": "Имена пакетов из nixpkgs, которыми можно заменить стандартный список компонента.",
      "type": "packages"
    },
    {
      "layer": "nixos",
      "path": [
        "services",
        "openssh",
        "enable"
      ],
      "title": "Сервер SSH",
      "description": "Запускает OpenSSH для удалённого доступа.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "networking",
        "networkmanager",
        "enable"
      ],
      "title": "NetworkManager",
      "description": "Управляет сетевыми подключениями через NetworkManager.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "bat"
      ],
      "title": "bat",
      "description": "Подключает bat в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "fastfetch"
      ],
      "title": "fastfetch",
      "description": "Подключает fastfetch в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "fzf"
      ],
      "title": "fzf",
      "description": "Подключает fzf в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "git"
      ],
      "title": "git",
      "description": "Подключает git в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "neovim"
      ],
      "title": "neovim",
      "description": "Подключает neovim в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "networkmanager"
      ],
      "title": "NetworkManager",
      "description": "Подключает NetworkManager в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "nh"
      ],
      "title": "nh",
      "description": "Подключает nh в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "nix-ld"
      ],
      "title": "nix-ld",
      "description": "Подключает nix-ld в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
