    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "usbutils"
      ],
      "title": "usbutils",
      "description": "Подключает usbutils в этом компоненте.",
      "type": "bool",
      "default": true
