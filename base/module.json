    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "zsh"
      ],
      "title": "zsh",
      "description": "Подключает zsh в этом компоненте.",
      "type": "bool",
      "default": true
    }
  ]
}
