      "description": "Подключает p7zip в этом компоненте.",
      "type": "bool",
      "default": true
    },
    {
      "layer": "nixos",
      "path": [
        "components",
        "base",
        "enabledPackages",
        "unzip"
      ],
      "title": "unzip",
      "description": "Подключает unzip в этом компоненте.",
      "type": "bool",
      "default": true
