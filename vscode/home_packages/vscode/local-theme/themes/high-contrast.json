{
  "$schema": "vscode://schemas/color-theme",
  "name": "High Contrast",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#ffffff",
    "focusBorder": "#00e5ff",
    "selection.background": "#00e5ff44",
    "descriptionForeground": "#c0cad6",
    "errorForeground": "#ff6677",
    "icon.foreground": "#c0cad6",
    "editor.background": "#080a0f",
    "editor.foreground": "#ffffff",
    "editorLineNumber.foreground": "#c0cad699",
    "editorLineNumber.activeForeground": "#00e5ff",
    "editorCursor.foreground": "#00e5ff",
    "editor.selectionBackground": "#66aaff44",
    "editor.inactiveSelectionBackground": "#66aaff22",
    "editor.lineHighlightBackground": "#1c243088",
    "editorWhitespace.foreground": "#667486",
    "editorIndentGuide.background1": "#667486",
    "editorIndentGuide.activeBackground1": "#c0cad6",
    "editor.selectionHighlightBackground": "#d59aff33",
    "editor.wordHighlightBackground": "#52f2e52b",
    "editor.wordHighlightStrongBackground": "#52f2e544",
    "editor.findMatchBackground": "#ffe45e66",
    "editor.findMatchHighlightBackground": "#ffe45e33",
    "editorBracketMatch.background": "#d59aff33",
    "editorBracketMatch.border": "#d59aff",
    "editorError.foreground": "#ff6677",
    "editorWarning.foreground": "#ffe45e",
    "editorInfo.foreground": "#66aaff",
    "editorGutter.addedBackground": "#63f59a",
    "editorGutter.modifiedBackground": "#66aaff",
    "editorGutter.deletedBackground": "#ff6677",
    "editorOverviewRuler.border": "#667486",
    "editorGroup.border": "#667486",
    "sideBar.background": "#11151d",
    "sideBar.foreground": "#ffffff",
    "sideBar.border": "#667486",
    "sideBarTitle.foreground": "#ffffff",
    "sideBarSectionHeader.background": "#1c2430",
    "activityBar.background": "#080a0f",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#c0cad6",
    "activityBar.border": "#667486",
    "activityBarBadge.background": "#00e5ff",
    "activityBarBadge.foreground": "#080a0f",
    "statusBar.background": "#1c2430",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#667486",
    "statusBar.debuggingBackground": "#ff6677",
    "statusBar.debuggingForeground": "#080a0f",
    "titleBar.activeBackground": "#080a0f",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#11151d",
    "titleBar.inactiveForeground": "#c0cad6",
    "tab.activeBackground": "#080a0f",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveBackground": "#11151d",
    "tab.inactiveForeground": "#c0cad6",
    "tab.border": "#667486",
    "tab.activeBorderTop": "#00e5ff",
    "panel.background": "#080a0f",
    "panel.border": "#667486",
    "panelTitle.activeBorder": "#00e5ff",
    "panelTitle.activeForeground": "#ffffff",
    "panelTitle.inactiveForeground": "#c0cad6",
    "terminal.background": "#080a0f",
    "terminal.foreground": "#ffffff",
    "terminalCursor.foreground": "#00e5ff",
    "terminal.ansiBlack": "#080a0f",
    "terminal.ansiRed": "#ff6677",
    "terminal.ansiGreen": "#63f59a",
    "terminal.ansiYellow": "#ffe45e",
    "terminal.ansiBlue": "#66aaff",
    "terminal.ansiMagenta": "#d59aff",
    "terminal.ansiCyan": "#52f2e5",
    "terminal.ansiWhite": "#ffffff",
    "terminal.ansiBrightBlack": "#c0cad6",
    "terminal.ansiBrightRed": "#ff6677",
    "terminal.ansiBrightGreen": "#63f59a",
    "terminal.ansiBrightYellow": "#ffe45e",
    "terminal.ansiBrightBlue": "#66aaff",
    "terminal.ansiBrightMagenta": "#d59aff",
    "terminal.ansiBrightCyan": "#52f2e5",
    "terminal.ansiBrightWhite": "#ffffff",
    "input.background": "#1c2430",
    "input.foreground": "#ffffff",
    "input.border": "#667486",
    "dropdown.background": "#1c2430",
    "dropdown.foreground": "#ffffff",
    "button.background": "#00e5ff",
    "button.foreground": "#080a0f",
    "button.hoverBackground": "#ffe45e",
    "list.activeSelectionBackground": "#66aaff44",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#1c2430",
    "list.hoverBackground": "#1c2430",
    "quickInput.background": "#11151d",
    "quickInput.foreground": "#ffffff",
    "notificationCenterHeader.background": "#11151d",
    "notifications.background": "#11151d",
    "badge.background": "#00e5ff",
    "badge.foreground": "#080a0f",
    "diffEditor.insertedTextBackground": "#63f59a22",
    "diffEditor.removedTextBackground": "#ff667722",
    "gitDecoration.addedResourceForeground": "#63f59a",
    "gitDecoration.modifiedResourceForeground": "#ffe45e",
    "gitDecoration.deletedResourceForeground": "#ff6677",
    "gitDecoration.untrackedResourceForeground": "#52f2e5"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c0cad6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#d59aff"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#63f59a"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#66aaff"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ffe45e"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#52f2e5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#52f2e5"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff6677"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffe45e"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6677",
        "fontStyle": "underline"
      }
    }
  ]
}
