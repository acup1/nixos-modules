custom-shader=cursor_blaze_blue.glsl
custom-shader=cursor_smear.glsl
theme=Aizen Dark
window-theme=auto
background-opacity=0.6
background-blur-radius=1
confirm-close-surface = false
quit-after-last-window-closed = true
shell-integration = zsh
title="ghostty"
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
keybind = ctrl+shift+comma=reload_config
keybind = super+shift+equal=increase_font_size:1
keybind = super+shift+minus=decrease_font_size:1
keybind = super+shift+zero=reset_font_size
keybind = super+shift+comma=reload_config
adjust-cursor-thickness = 2
cursor-color = #999999
cursor-opacity = 0.8
font-family = "CodeNewRoman"
font-size = 13
